                            "edit": {
                                "type": "SelectVariable"
                            },
                            "add": 0
                        },
                        {
                            "caption": "PV String 3",
                            "name": "PVVariable3",
                            "width": "160px",
                            "edit": {
                                "type": "SelectVariable"
                            },
                            "add": 0
