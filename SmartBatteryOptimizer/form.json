    "actions": [
        {
            "type": "Button",
            "caption": "Jetzt Prognose & Plan berechnen",
            "onClick": "SBO_Recalculate($id);"
        },
        {
            "type": "Button",
            "caption": "Nur Nachtverbrauch neu lernen",
            "onClick": "SBO_LearnNightConsumption($id);"
        },
        {
            "type": "Button",
            "caption": "Verbrauchsprofil neu lernen",
            "onClick": "SBO_LearnConsumptionProfile($id);"
        },
        {
            "type": "Button",
            "caption": "PV-Kalibrierung / Auto-Faktoren zurücksetzen",
            "onClick": "SBO_ResetPVCalibration($id);"
        },
        {
            "type": "Button",
            "caption": "Einspeisung sofort stoppen",
            "onClick": "SBO_StopFeedIn($id);"
        }
